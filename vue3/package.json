{
  "name": "team-task-manager-frontend",
  "version": "1.0.0",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "audit": "echo 'This should be in automated weekly schedule' && pnpm audit",
    "dev": "vite",
    "dev:r": "pnpm add -D",
    "dev:rm": "pnpm remove",
    "dev:preview": "vite preview",
    "prod:i1": "pnpm install --frozen-lockfile",
    "prod:build": "vite build",
    "prod:i2": "pnpm install --frozen-lockfile --prod",
    "lint": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.6.0",
    "element-plus": "^2.14.3",
    "pinia": "^2.2.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "vite": "^5.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.3.0",
    "vue-tsc": "^3.3.7"
  }
}
