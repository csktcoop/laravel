{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "ignoreUnknown": true
  },

  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "linter": {
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "info",
        "useSemanticElements": "info"
      }
    }
  },

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },

  "html": {
    "experimentalFullSupportEnabled": true,
    "parser": {
      "vue": true
    }
  }
}
